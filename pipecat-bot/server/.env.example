# pipecat-bot - Environment Variables
# Copy this file to .env and fill in your API keys

# --- LLM: local model served by LM Studio (OpenAI-compatible API) ---
# Start LM Studio, load the model, and turn on its local server.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=google/gemma-4-e4b
# LM Studio ignores this, but the OpenAI client requires a non-empty value.
LLM_API_KEY=lm-studio

# --- STT + TTS: Sarvam (get a key at https://dashboard.sarvam.ai) ---
SARVAM_API_KEY=
# "auto" detects the spoken language per utterance; "hi-IN" pins Hindi/Hinglish.
SARVAM_STT_LANGUAGE=auto
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=aditya

# --- RAG: knowledge-base retrieval over the Amazon.in help corpus ---
RAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Tuned by `uv run python -m rag.tune_thresholds` against the committed corpus:
# HIGH sits above the strongest unanswerable-trap score (0.86); FLOOR is the
# trap median. The MID band in between deflects via its injected instruction.
RAG_THRESHOLD_HIGH=0.89
RAG_THRESHOLD_FLOOR=0.60

# --- Rollback path (unused since the Sarvam switch) ---
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# CARTESIA_MODEL=sonic-3.6
# CARTESIA_VOICE_ID=47c38ca4-5f35-497b-b1a3-415245fb35e1

# --- Transport: Twilio (telephony) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Transport: Daily (WebRTC; not available on Windows) ---
DAILY_API_KEY=
# Optional: leave empty to create a new room
# DAILY_ROOM_URL=
